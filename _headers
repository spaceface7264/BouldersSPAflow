# Security headers for Cloudflare Pages
# Applied to all static assets (HTML, JS, CSS)
# See: https://developers.cloudflare.com/pages/platform/headers/

/*
  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff

  # Prevent clickjacking
  X-Frame-Options: DENY

  # Control referrer information
  Referrer-Policy: strict-origin-when-cross-origin

  # Enable browser XSS protection (legacy support)
  X-XSS-Protection: 1; mode=block

  # Strict Transport Security (HSTS) - Force HTTPS
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy (CSP)
  # Note: Using 'unsafe-inline' for scripts due to inline GTM initialization code
  # TODO: Migrate to nonces for better security (requires server-side nonce generation)
  # 'unsafe-eval' has been removed as it's not needed (no eval() or new Function() usage)
  # Google Ads conversion tracking (AW-805899643) runs through GTM. Domains follow Google's CSP
  # reference for Conversion/Remarketing/Conversion Linker tags:
  # https://developers.google.com/tag-platform/security/guides/csp
  # doubleclick.net is also allowed in frame-src for the legacy view-through conversion iframe.
 Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://consent.cookiebot.com https://consentcdn.cookiebot.com https://connect.facebook.net https://browser.sentry-cdn.com https://*.doubleclick.net https://www.googleadservices.com https://www.google.com https://pagead2.googlesyndication.com https://analytics.tiktok.com https://analytics-ipv6.tiktokw.us https://ads.tiktok.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://consent.cookiebot.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api-join.boulders.dk https://boulders.brpsystems.com https://*.google-analytics.com https://*.googletagmanager.com https://gtm.join.boulders.dk https://www.google.com https://google.com https://www.google.dk https://*.googleadservices.com https://*.googlesyndication.com https://*.ingest.de.sentry.io https://browser.sentry-cdn.com https://www.facebook.com https://consent.cookiebot.com https://consentcdn.cookiebot.com https://*.doubleclick.net https://analytics.tiktok.com https://analytics-ipv6.tiktokw.us https://ads.tiktok.com; frame-src 'self' https://*.googletagmanager.com https://gtm.join.boulders.dk https://*.doubleclick.net https://www.facebook.com https://consent.cookiebot.com https://consentcdn.cookiebot.com; object-src 'none'; base-uri 'self'; form-action 'self' https://www.facebook.com; upgrade-insecure-requests;

  # Permissions Policy (formerly Feature Policy)
  # Restrict browser features to minimize attack surface
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Additional headers for API proxy function
/api-proxy/*
  # CORS handled in the function itself
  # Security headers added in getSecurityHeaders()

# Cache control for static assets
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# Don't cache HTML files
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# SEO: prevent campaign landing routes from being indexed
/freetrial
  X-Robots-Tag: noindex, nofollow

/membership-offer
  X-Robots-Tag: noindex, nofollow

/
  Cache-Control: public, max-age=0, must-revalidate
